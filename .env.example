# Bridge HTTP server port
PORT=7153

# IP address of your local Firewalla box
FIREWALLA_IP=192.168.1.1

# Directory where cryptographic ETP keys are stored
KEY_DIR=/app/keys

# Optional display name override for your Firewalla box
BOX_NAME=Firewalla Purple

# Optional: Require authentication token for API access (Header "Authorization: Token <token>")
# Leave empty for open LAN access (default)
# API_TOKEN=your_secure_random_token_here

# Optional: Merge bonded / multi-NIC devices into a single virtual device.
# Helpful for servers or NAS devices running LACP, balance-alb, or dual Ethernet.
#
# Formats supported:
# 1. Shorthand: Name:IP:MAC1,MAC2,... (multiple devices separated by semicolon)
#    MERGE_DEVICES=Server:192.168.1.100:aa:bb:cc:dd:ee:01,aa:bb:cc:dd:ee:02
#
# 2. JSON:
#    MERGE_DEVICES=[{"name":"Server","ip":"192.168.1.100","primaryId":"AA:BB:CC:DD:EE:01","macs":["aa:bb:cc:dd:ee:01","aa:bb:cc:dd:ee:02"]}]
